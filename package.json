{
  "name": "dshm-backup",
  "version": "0.2.0",
  "description": "DSHM（HarmonyOS DeepSeek Harness）全量备份与灾难恢复：聊天记录、图片附件、工作区、插件本体/配置、技能与凭据，一份 ZIP 离线恢复。纯宿主插件，零第三方依赖。",
  "private": false,
  "type": "module",
  "main": "lib/index.js",
  "license": "MIT",
  "files": [
    "lib/index.js",
    "lib/backup.js",
    "lib/restore.js",
    "lib/zip.js",
    "lib/format.js",
    "lib/util.js",
    "lib/environment.js",
    "lib/client.js",
    "cordis.patch.yml",
    "README.md"
  ],
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
